# Build a rebranded Odoo fork from git (Fincomtech and similar).
# Official Community images (odoo:10 … odoo:19) do not need this file.
#
#   docker build -f images/Dockerfile.fork \
#     --build-arg ODOO_GIT=https://git.example.com/fincomtech.git \
#     --build-arg ODOO_BRANCH=17.0 \
#     --build-arg PYTHON_VERSION=3.10 \
#     --build-arg PLATFORM_NAME=fincomtech \
#     -t registry.example.com/fincomtech:17.0 .

ARG BASE_IMAGE=debian:12-slim
FROM ${BASE_IMAGE}

ARG PYTHON_VERSION=3.10
ARG ODOO_GIT=https://github.com/odoo/odoo.git
ARG ODOO_BRANCH=17.0
ARG PLATFORM_NAME=odoo

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    ODOO_RC=/etc/odoo/${PLATFORM_NAME}.conf \
    PATH="/opt/venv/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git gcc xz-utils \
        python3 python3-venv python3-dev python3-pip \
        libpq-dev libldap2-dev libsasl2-dev libssl-dev \
        libxml2-dev libxslt1-dev libjpeg-dev zlib1g-dev libffi-dev \
        postgresql-client \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -ms /bin/bash -u 101 odoo \
    && mkdir -p /opt/odoo /var/lib/odoo /mnt/extra-addons /etc/odoo /opt/venv \
    && chown -R odoo:odoo /opt/odoo /var/lib/odoo /mnt/extra-addons /etc/odoo /opt/venv

COPY images/entrypoint-fork.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

USER odoo
WORKDIR /opt/odoo

RUN git clone --depth 1 --branch "${ODOO_BRANCH}" "${ODOO_GIT}" /opt/odoo \
    && python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip wheel \
    && if [ -f /opt/odoo/requirements.txt ]; then /opt/venv/bin/pip install -r /opt/odoo/requirements.txt; fi

EXPOSE 8069 8072
VOLUME ["/var/lib/odoo", "/mnt/extra-addons"]

ENTRYPOINT ["/entrypoint.sh"]
CMD ["odoo"]
